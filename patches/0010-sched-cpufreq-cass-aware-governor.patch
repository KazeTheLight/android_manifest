 /*
  * Verify the fitness of task @p to run on @cpu taking into account the
  * CPU original capacity and the runtime/deadline ratio of the task.
--- /dev/null
+++ b/kernel/sched/cpufreq_cassgov.c
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CASS-aware cpufreq governor.
+ *
+ * Copyright (c) 2026 K-One-Kernel
+ *
+ * Rationale
+ * ---------
+ * The stock frequency path derives its request from a raw CFS utilisation
+ * figure that counts realtime, deadline and IRQ time as if they were
+ * ordinary runnable work, and that does not account for thermal pressure at
+ * all. A runqueue that is mostly running kernel work, or that is being
+ * throttled, therefore reads as busy and holds the cluster high.
+ *
+ * CASS already subtracts exactly those terms when it compares runqueues, so
+ * this governor reuses that same accounting through cass_cpufreq_util(). The
+ * frequency then follows the load CASS actually believes is present instead
+ * of a more pessimistic figure.
+ *
+ * Behaviour
+ * ---------
+ * The governor samples on a fixed tick rather than racing the scheduler, it
+ * bounds how far the frequency may move per tick in either direction, and it
+ * drops straight to the policy minimum when no CPU in the policy reports any
+ * load at all. That last part is deliberate: clamping the step there would
+ * only add wakeups, which is the opposite of the intent.
+ *
+ * Nothing here is required for the rest of the system to be correct. The
+ * governor is opt-in and can be selected at runtime with
+ *
+ *     echo cassgov > /sys/devices/system/cpu/cpuX/cpufreq/scaling_governor
+ *
+ * and the stock governor restored the same way.
+ */
+
+#include <linux/cpufreq.h>
+#include <linux/cgroup.h>
+#include <linux/cpumask.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/workqueue.h>
+
+#include "sched.h"
+
+/* Recompute the policy frequency every 20 ms. */
+#define CASSGOV_INTERVAL		(HZ / 50)
+
+/*
+ * cass_cpufreq_util() reports on the same 0..1024 capacity scale the
+ * scheduler uses internally, so the governor never has to reason about
+ * per-CPU capacities itself.
+ */
+#define CASSGOV_UTIL_SCALE		1024
+
+/*
+ * Ramping bounds. Downward moves are allowed to be larger because the
+ * complaint this governor exists for is a cluster that stays pinned high
+ * while idle. Upward moves are capped harder so that a single busy sample
+ * cannot slam a core to its maximum and hold it there.
+ */
+#define CASSGOV_UP_SHIFT		2	/* at most +25% of current */
+#define CASSGOV_DOWN_SHIFT		1	/* at most -50% of current */
+
+struct cassgov_policy {
+	struct cpufreq_policy	*policy;
+	struct delayed_work	work;
+	unsigned int		last_freq;
+	bool			active;
+};
+
+/* Highest load reported by any CPU in the policy, in 0..1024 units. */
+static unsigned int cassgov_pick_util(struct cpufreq_policy *policy)
+{
+	unsigned int util = 0;
+	int cpu;
+
+	for_each_cpu(cpu, policy->cpus) {
+		unsigned int u = cass_cpufreq_util(cpu);
+
+		if (u > util)
+			util = u;
+	}
+
+	return util;
+}
+
+static unsigned int cassgov_next_freq(struct cassgov_policy *cgp)
+{
+	struct cpufreq_policy *policy = cgp->policy;
+	unsigned int cur, min, max, freq, util, step;
+
+	min = policy->cpuinfo.min_freq;
+	max = policy->cpuinfo.max_freq;
+	cur = policy->cur;
+
+	if (min > max)
+		swap(min, max);
+
+	util = cassgov_pick_util(policy);
+	if (!util)
+		return min;
+
+	freq = min + div_u64((u64)(max - min) * util, CASSGOV_UTIL_SCALE);
+	freq = cpufreq_driver_resolve_freq(policy, freq);
+	freq = clamp(freq, min, max);
+
+	step = cur >> CASSGOV_UP_SHIFT;
+	if (freq > cur + step)
+		freq = cur + step;
+
+	step = cur >> CASSGOV_DOWN_SHIFT;
+	if (freq + step < cur)
+		freq = cur + step;
+
+	return clamp(freq, min, max);
+}
+
+static void cassgov_work(struct work_struct *work)
+{
+	struct cassgov_policy *cgp = container_of(to_delayed_work(work),
+						  struct cassgov_policy, work);
+	unsigned int new_freq;
+
+	if (!cgp->active)
+		return;
+
+	new_freq = cassgov_next_freq(cgp);
+	if (new_freq != cgp->last_freq) {
+		cpufreq_driver_target(cgp->policy, new_freq,
+				      CPUFREQ_RELATION_L);
+		cgp->last_freq = new_freq;
+	}
+
+	schedule_delayed_work(&cgp->work, CASSGOV_INTERVAL);
+}
+
+static int cassgov_start(struct cpufreq_policy *policy)
+{
+	struct cassgov_policy *cgp = policy->governor_data;
+
+	cgp->last_freq = policy->cur;
+	cgp->active = true;
+
+	schedule_delayed_work(&cgp->work, CASSGOV_INTERVAL);
+
+	return 0;
+}
+
+static void cassgov_stop(struct cpufreq_policy *policy)
+{
+	struct cassgov_policy *cgp = policy->governor_data;
+
+	cgp->active = false;
+	cancel_delayed_work_sync(&cgp->work);
+}
+
+static int cassgov_init(struct cpufreq_policy *policy);
+static void cassgov_exit(struct cpufreq_policy *policy);
+static void cassgov_limits(struct cpufreq_policy *policy);
+
+static struct cpufreq_governor cassgov_gov = {
+	.name			= "cassgov",
+	.owner			= THIS_MODULE,
+	.flags			= CPUFREQ_GOV_DYNAMIC_SWITCHING,
+	.init			= cassgov_init,
+	.exit			= cassgov_exit,
+	.start			= cassgov_start,
+	.stop			= cassgov_stop,
+	.limits			= cassgov_limits,
+};
+
+static int cassgov_init(struct cpufreq_policy *policy)
+{
+	struct cassgov_policy *cgp;
+
+	if (!policy->governor_data) {
+		cgp = kzalloc(sizeof(*cgp), GFP_KERNEL);
+		if (!cgp)
+			return -ENOMEM;
+
+		INIT_DELAYED_WORK(&cgp->work, cassgov_work);
+		policy->governor_data = cgp;
+		cgp->policy = policy;
+	}
+
+	policy->governor = &cassgov_gov;
+
+	return 0;
+}
+
+static void cassgov_exit(struct cpufreq_policy *policy)
+{
+	struct cassgov_policy *cgp = policy->governor_data;
+
+	policy->governor = NULL;
+	if (cgp) {
+		cgp->active = false;
+		cancel_delayed_work_sync(&cgp->work);
+		kfree(cgp);
+	}
+	policy->governor_data = NULL;
+}
+
+static void cassgov_limits(struct cpufreq_policy *policy)
+{
+	struct cassgov_policy *cgp = policy->governor_data;
+
+	if (!cgp->active)
+		return;
+
+	/* Force the next tick to re-evaluate against the new bounds. */
+	cgp->last_freq = 0;
+	mod_delayed_work(system_wq, &cgp->work, 0);
+}
+
+static int __init cassgov_register(void)
+{
+	return cpufreq_register_governor(&cassgov_gov);
+}
+core_initcall(cassgov_register);
+
+static void __exit cassgov_unregister(void)
+{
+	cpufreq_unregister_governor(&cassgov_gov);
+}
+module_exit(cassgov_unregister);
+
+MODULE_DESCRIPTION("CASS-aware cpufreq governor");
+MODULE_LICENSE("GPL");
