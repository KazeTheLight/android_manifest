+
+/*
+ * Utilisation report for the CASS-aware cpufreq governor.
+ *
+ * Returns the runqueue load on the 0..1024 capacity scale the scheduler uses
+ * internally, measured exactly the way CASS measures a runqueue when deciding
+ * whether work should move: util_est is folded into util_avg, and thermal
+ * pressure plus realtime, deadline and IRQ time are removed from the
+ * capacity. A runqueue that is mostly burning kernel time, or that is being
+ * throttled, therefore no longer reads as ordinary busy work and no longer
+ * pushes the frequency up.
+ *
+ * util is already expressed in capacity units: it has been clamped to the
+ * reduced capacity, which is itself bounded by arch_scale_cpu_capacity() and
+ * therefore by SCHED_CAPACITY_SCALE. No rescaling is needed.
+ */
+unsigned int cass_cpufreq_util(int cpu)
+{
+	unsigned long cap, util;
+
+	if (!sched_asym_cpucap_active())
+		return 0;
+
+	cap = cass_recheck_rq_cap(cpu_rq(cpu), cpu);
+	if (!cap)
+		return 0;
+
+	util = min(cass_recheck_rq_util(cpu_rq(cpu)), cap);
+
+	return util;
+}
