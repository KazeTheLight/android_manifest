+config CPU_FREQ_GOV_CASSGOV
+	bool "'cassgov' cpufreq policy governor"
+	depends on CPU_FREQ && SMP && SCHED_CASS
+	help
+	  CASS-aware cpufreq governor. It derives the frequency request from the
+	  same runqueue accounting CASS uses when it compares CPUs, so realtime,
+	  deadline and IRQ time as well as thermal pressure no longer inflate the
+	  reported load. Built in rather than modular because it reads CASS
+	  scheduler internals directly.
+	
+	  This governor is not selected by default. Pick it at runtime by writing
+	  "cassgov" to the scaling_governor sysfs attribute of a policy.
+
 config CPU_FREQ_GOV_SCHEDUTIL
 	bool "'schedutil' cpufreq policy governor"
 	depends on CPU_FREQ && SMP
