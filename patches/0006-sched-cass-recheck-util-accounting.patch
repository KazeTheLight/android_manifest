 #define CASS_RECHECK_SLACK	(SCHED_CAPACITY_SCALE / 8)
 
 #ifdef CONFIG_SCHED_CASS
+/*
+ * Run queue accounting, mirroring cass_cpu_util() so that the periodic recheck
+ * and the wakeup path measure a runqueue the same way.
+ *
+ * The recheck used to read avg.util_avg raw and never removed RT/DL/IRQ time
+ * from the source, while candidates were charged for it. That asymmetry made
+ * the source look relatively emptier than it really was and pushed candidates
+ * relatively busier, so the recheck kept migrating work that did not really
+ * need to move. util_est is included for the same reason cass_cpu_util() uses
+ * it: a runqueue that is about to burst must not read as idle right now.
+ */
+static unsigned long cass_recheck_rq_util(struct rq *rq)
+{
+	unsigned long est, util;
+
+	util = READ_ONCE(rq->cfs.avg.util_avg);
+	if (sched_feat(UTIL_EST)) {
+		est = READ_ONCE(rq->cfs.avg.util_est);
+		if (est > util)
+			util = est;
+	}
+
+	return util;
+}
+
+static unsigned long cass_recheck_rq_cap(struct rq *rq, int cpu)
+{
+	unsigned long cap;
+
+	cap = arch_scale_cpu_capacity(cpu) - thermal_load_avg(rq);
+	if (!cap)
+		return 0;
+
+	return cap - min(cpu_util_rt(rq) + cpu_util_dl(rq) + cpu_util_irq(rq),
+			 cap - 1);
+}
