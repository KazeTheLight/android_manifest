 	 * On asymmetric system, update task utilization because we will check
@@ -7628,6 +7721,18 @@
 		return prev;
 	}
 
+#ifdef CONFIG_SCHED_CASS
+	/*
+	 * Periodic re-evaluation: ask CASS whether another idle CPU would
+	 * suit this task better than the ones considered below. Runs only on
+	 * the load balancing path, not on wakeup, so the cost is bounded.
