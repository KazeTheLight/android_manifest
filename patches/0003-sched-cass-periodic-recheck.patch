+#ifdef CONFIG_SCHED_CASS
+/*
+ * CASS re-evaluation for the periodic load balancing path.
+ *
+ * cass_select_task_rq_fair() only runs on wakeup, so a task that has been
+ * running (and whose relative utilisation has since drifted) is never
+ * reconsidered by CASS. This hook lets the periodic balancer ask CASS which
+ * CPU it would prefer, using the same relative-utilisation metric, so a
+ * long-running task can be migrated to a better fitting CPU.
+ *
+ * Returns a CPU index, or -1 when CASS has no better candidate, in which
+ * case the caller falls back to the stock selection path.
+ */
+static int cass_select_idle_cpu(struct task_struct *p)
+{
+	unsigned long task_util, util_min, util_max;
+	unsigned long best_ratio = ~0UL, ratio;
+	unsigned long this_util, this_cap, this_ratio;
+	struct cpumask *cpus;
+	int cpu, best_cpu = -1;
+	struct rq *this_rq = this_rq();
+
+	if (!sched_asym_cpucap_active())
+		return -1;
+
+	sync_entity_load_avg(&p->se);
+	task_util = task_util_est(p);
+	util_min = uclamp_eff_value(p, UCLAMP_MIN);
+	util_max = uclamp_eff_value(p, UCLAMP_MAX);
+
+	/* Relative utilisation of the CPU the task is running on now. */
+	this_cap = arch_scale_cpu_capacity(this_rq->cpu) - thermal_load_avg(this_rq);
+	if (!this_cap)
+		return -1;
+	this_util = READ_ONCE(this_rq->cfs.avg.util_avg);
+	if (this_util > this_cap)
+		this_util = this_cap;
+	this_ratio = div_u64(this_util << 10, this_cap);
+
+	cpus = this_cpu_cpumask_var_ptr(select_rq_mask);
+	cpumask_and(cpus, p->cpus_ptr, cpu_online_mask);
+
+	for_each_cpu_wrap(cpu, cpus, this_rq->cpu) {
+		struct rq *rq = cpu_rq(cpu);
+		unsigned long cap, util;
+
+		/* Only consider CPUs that are actually idle, and that the
+		 * task is allowed to run on.
+		 */
+		if (!available_idle_cpu(cpu) && !sched_idle_cpu(cpu))
+			continue;
+		if (!cpumask_test_cpu(cpu, p->cpus_ptr))
+			continue;
+
+		/*
+		 * Never move a task to a CPU that cannot hold it, otherwise
+		 * the periodic balancer would undo what the wakeup path
+		 * (and uclamp) carefully avoided.
+		 */
+		if (util_fits_cpu(task_util, util_min, util_max, cpu) <= 0)
+			continue;
+
+		cap = arch_scale_cpu_capacity(cpu) - thermal_load_avg(rq);
+		if (!cap)
+			continue;
+
+		util = READ_ONCE(rq->cfs.avg.util_avg);
+		if (util > cap)
+			util = cap;
+
+		/* Same metric as the wakeup path: utilisation relative to
+		 * capacity. Smaller is better.
+		 */
+		ratio = div_u64(util << 10, cap);
+		if (ratio >= this_ratio)
+			continue;
+
+		if (ratio < best_ratio) {
+			best_ratio = ratio;
+			best_cpu = cpu;
+		}
+	}
+
+	return best_cpu;
+}
+#endif /* CONFIG_SCHED_CASS */
+
